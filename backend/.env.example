# Modo emulador (desenvolvimento local) — não precisa de service account.
# Rode: firebase emulators:start  (na pasta frontend)
# IMPORTANTE: FIREBASE_PROJECT_ID precisa ser o MESMO projeto do emulador.
# O `firebase emulators:start` usa o projeto do frontend/.firebaserc.
FIRESTORE_EMULATOR_HOST=localhost:8070
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-scandoc

# Modo produção — duas opções (use uma delas):
# A) Cole aqui o CONTEÚDO (JSON) do service account gerado em:
#    Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# B) Ou aponte para o arquivo baixado:
# GOOGLE_APPLICATION_CREDENTIALS=D:\caminho\para\service-account.json

# Pagamentos Stripe (PAYMENT_PROVIDER=stripe). Use as chaves de teste do Stripe
# enquanto estiver em desenvolvimento.
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  # do Event Destination (Stripe > Developers > Event destinations)
# STRIPE_PRICE_BASICO=price_...
# STRIPE_PRICE_PROFISSIONAL=price_...
# STRIPE_PRICE_AVANCADO=price_...
# STRIPE_PRICE_ILIMITADO=price_...
# APP_BASE_URL=https://scandoc-f29de.web.app

# Em produção, defina também (ex.: no Render):
# CORS_ORIGINS=https://scandoc.web.app

# QUOTA_WINDOW_HOURS=24
# MAX_UPLOAD_MB=25
