# Modo emulador (desenvolvimento local) — não precisa de service account.
# Rode: firebase emulators:start  (na pasta frontend)
FIRESTORE_EMULATOR_HOST=localhost:8070
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-scandoc

# Modo produção — duas opções (use uma delas):
# A) Cole aqui o CONTEÚDO (JSON) do service account gerado em:
#    Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# B) Ou aponte para o arquivo baixado:
# GOOGLE_APPLICATION_CREDENTIALS=D:\caminho\para\service-account.json

# Em produção, defina também (ex.: no Render):
# CORS_ORIGINS=https://scandoc.web.app

# QUOTA_WINDOW_HOURS=24
# MAX_UPLOAD_MB=25
