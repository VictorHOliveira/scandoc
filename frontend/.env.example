# Modo emulador local (recomendado para desenvolvimento) — copie para .env:
# VITE_USE_EMULATOR=true
# VITE_FIREBASE_API_KEY=demo-api-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-scandoc.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-scandoc
# VITE_FIREBASE_APP_ID=demo-app-id

# Modo produção — preencha com os dados reais do projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > Web)
# VITE_USE_EMULATOR=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL do backend em produção (ex.: https://scandoc-api.onrender.com)
# Em desenvolvimento, deixe vazio para usar o proxy do Vite (/api -> localhost:8000)
VITE_API_URL=
